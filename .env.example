# Chave secreta usada para assinar e verificar os tokens JWT (login).
# Deve ter pelo menos 32 bytes. Gere uma com: openssl rand -hex 32
APP_JWT_SECRET=coloque_uma_chave_aleatoria_de_pelo_menos_32_bytes_aqui

# Tempo de expiração do token, em milissegundos (opcional, padrão 86400000 = 24h).
APP_JWT_EXPIRATION_MS=86400000
